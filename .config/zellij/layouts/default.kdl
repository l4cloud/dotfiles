layout {
    default_tab_template {
         pane size=1 borderless=true {
             plugin location="zellij:tab-bar"
         }
         children
     }
    tab name="1" hide_floating_panes=true {
        pane command="nvim"
        }
    tab name="2" hide_floating_panes=true {
        pane
    }
    tab name="3" hide_floating_panes=true {
        pane
    }
}
